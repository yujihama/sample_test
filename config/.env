# アプリケーション設定
APP_NAME=内部監査サンプルデータ自動テストAIエージェントシステム
APP_VERSION=0.1.0
APP_ENV=development
# development, testing, production
APP_HOST=0.0.0.0
APP_PORT=8000

# LLMモデル設定
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# データベース設定
DB_PATH=./data/db/audit_agent_new.db
DB_TYPE=sqlite
# 以下はSQLiteではなくPostgreSQLなどを使用する場合の設定
DATABASE_URL=sqlite:///./data/db/audit_agent_new.db

# LLM設定
LLM_PROVIDER=openai
# openai, anthropic, azure
LLM_MODEL_NAME=gpt-4o
# gpt-4o, gpt-3.5-turbo, claude-3-opus, etc.
LLM_TEMPERATURE=0.1
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Azure OpenAI設定 (Azure OpenAIを使用する場合)
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_API_VERSION=2023-08-01-preview

# ロギング設定
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/audit_agent.log

# エージェント設定
AGENT_A_ID=agent-a
AGENT_B_ID=agent-b
AGENT_C_ID=agent-c
AGENT_D_ID=agent-d

# ファイル保存パス
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
TEMP_DIR=./data/temp

# セキュリティ設定
SECRET_KEY=generate-a-secure-random-key-here
# OpenSSL を使用して生成: openssl rand -hex 32
# または Python で生成: python -c "import secrets; print(secrets.token_hex(32))"

# ネットワーク設定
REQUEST_TIMEOUT=30

# テスト設定
TEST_DATA_DIR=./tests/data 